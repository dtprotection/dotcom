{
  "name": "dtprotection-monolith",
  "version": "1.0.0",
  "description": "DT Protection booking system - Monolithic deployment",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "cd frontend && next build",
    "start": "node dist/server.js",
    "start:dev": "ts-node server.ts",
    "lint": "cd frontend && next lint",
    "create-admin": "ts-node backend/src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.515.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "next": "15.2.4",
    "nodemailer": "^6.9.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.5.7",
    "@types/nodemailer": "^6.4.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "tailwindcss": "^4.1.10",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
